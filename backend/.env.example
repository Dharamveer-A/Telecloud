# ==========================================
# TeleCloud Environment Variables
# ==========================================

# Telegram API Credentials (from https://my.telegram.org)
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash

# Cryptography & Security Secrets (generate 32-byte hex, e.g. `openssl rand -hex 32`)
MASTER_ENCRYPTION_KEY=your_64_character_hex_master_key
JWT_SECRET=your_jwt_secret_hex

# Server Port
PORT=4000

# Chunk sizing (Defaults: 30MB for streamable media, 1.90GB for non-media)
CHUNK_SIZE_BYTES=31457280
MAX_TELEGRAM_FILE_BYTES=1900000000

# Lifetime-Free Cloud Deployment (Render.com)
# Set RENDER=true to activate automatic SQLite backup to Telegram Saved Messages
RENDER=false
DATA_DIR=./data
AUTO_TUNNEL=false

# Bootstrap session for restoring SQLite DB on Render restarts:
# Run `npx tsx scripts/getSession.ts` locally to get this encrypted value.
BOOTSTRAP_TELEGRAM_SESSION=
